{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "agent-base",
    "version": "0.1.0",
    "description": "Shared sandbox baseline for coding agents launched from the shell"
  },
  "groups": {
    "include": [
      "nix_runtime",
      "node_runtime",
      "git_config",
      "go_runtime",
      "rust_runtime",
      "python_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      },
      {
        "name": "user_caches_macos",
        "when": "macos"
      }
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": ["$HOME/.agents", "$HOME/.local/share/fnm", "$HOME/.config/worktrunk", "$HOME/.config/gh"],
    "read_file": ["$HOME/.ssh/known_hosts"],
    "bypass_protection": ["$HOME/.ssh/known_hosts"],
    "allow": ["$HOME/repos", "$HOME/.artifacts", "$HOME/.cache", "$HOME/go/pkg/mod", "$HOME/.cargo/registry", "$HOME/.cargo/git"]
  },
  "network": {
    "open_port": [8642]
  },
  "environment": {
    "deny_vars": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AZURE_CLIENT_SECRET", "AZURE_CLIENT_CERTIFICATE_PASSWORD", "ARM_CLIENT_SECRET", "OP_SERVICE_ACCOUNT_TOKEN"]
  },
  "rollback": {
    "exclude_patterns": ["node_modules", "target", ".direnv", "result"]
  },
  "command_policies": {
    "commands": {
      "kubectl": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["$HOME/.kube"],
              "fs_write": ["$HOME/.kube/cache"],
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": ["HOME", "PATH", "TERM", "KUBECONFIG"]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {"argv": {"contains": ["--kubeconfig"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--context"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--cluster"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--server"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--token"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--as"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--as-group"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--as-uid"]}, "reason": "agents stay on the shell's current context with the shell's identity"},
                {"argv": {"contains": ["--raw"]}, "reason": "agents stay on the shell's current context with the shell's identity"}
              ],
              "allow": [
                {"argv": {"prefix": ["get"]}},
                {"argv": {"prefix": ["describe"]}},
                {"argv": {"prefix": ["logs"]}},
                {"argv": {"prefix": ["top"]}},
                {"argv": {"prefix": ["explain"]}},
                {"argv": {"prefix": ["events"]}},
                {"argv": {"prefix": ["diff"]}},
                {"argv": {"prefix": ["api-resources"]}},
                {"argv": {"prefix": ["api-versions"]}},
                {"argv": {"prefix": ["version"]}},
                {"argv": {"prefix": ["cluster-info"]}},
                {"argv": {"prefix": ["auth", "can-i"]}},
                {"argv": {"prefix": ["auth", "whoami"]}},
                {"argv": {"prefix": ["rollout", "status"]}},
                {"argv": {"prefix": ["rollout", "history"]}},
                {"argv": {"prefix": ["config", "view"]}},
                {"argv": {"prefix": ["config", "get-contexts"]}},
                {"argv": {"prefix": ["config", "current-context"]}},
                {"argv": {"prefix": ["config", "get-clusters"]}},
                {"argv": {"prefix": ["config", "get-users"]}}
              ]
            }
          }
        }
      },
      "aws": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["$HOME/.aws", "/nix/store"],
              "fs_write": ["$HOME/.aws/cli/cache", "$HOME/.aws/sso/cache"],
              "unsafe_macos_seatbelt_rules": ["(allow process-exec* (subpath \"/nix/store\"))"],
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": ["HOME", "PATH", "TERM", "AWS_PROFILE", "AWS_REGION", "AWS_DEFAULT_REGION", "AWS_PAGER"]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {"argv": {"contains": ["--profile"]}, "reason": "agents use the shell's AWS_PROFILE and the default endpoint"},
                {"argv": {"contains": ["--endpoint-url"]}, "reason": "agents use the shell's AWS_PROFILE and the default endpoint"},
                {"argv": {"contains": ["--ca-bundle"]}, "reason": "agents use the shell's AWS_PROFILE and the default endpoint"},
                {"argv": {"contains": ["--no-verify-ssl"]}, "reason": "agents use the shell's AWS_PROFILE and the default endpoint"}
              ],
              "allow": [
                {"argv": {"prefix": ["sts", "get-caller-identity"]}},
                {"argv": {"prefix": ["configure", "list"]}},
                {"argv": {"prefix": ["configure", "list-profiles"]}},
                {"argv": {"prefix": ["configure", "get"]}},
                {"argv": {"prefix": ["ec2", "describe-instances"]}},
                {"argv": {"prefix": ["ec2", "describe-volumes"]}},
                {"argv": {"prefix": ["ec2", "describe-snapshots"]}},
                {"argv": {"prefix": ["ec2", "describe-images"]}},
                {"argv": {"prefix": ["ec2", "describe-vpcs"]}},
                {"argv": {"prefix": ["ec2", "describe-subnets"]}},
                {"argv": {"prefix": ["ec2", "describe-security-groups"]}},
                {"argv": {"prefix": ["ec2", "describe-regions"]}},
                {"argv": {"prefix": ["ec2", "describe-availability-zones"]}},
                {"argv": {"prefix": ["ec2", "describe-instance-types"]}},
                {"argv": {"prefix": ["ec2", "describe-reserved-instances"]}},
                {"argv": {"prefix": ["ec2", "describe-spot-price-history"]}},
                {"argv": {"prefix": ["ec2", "describe-nat-gateways"]}},
                {"argv": {"prefix": ["ec2", "describe-addresses"]}},
                {"argv": {"prefix": ["s3", "ls"]}},
                {"argv": {"prefix": ["s3api", "list-buckets"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-location"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-tagging"]}},
                {"argv": {"prefix": ["s3api", "list-objects-v2"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-versioning"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-encryption"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-policy"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-policy-status"]}},
                {"argv": {"prefix": ["s3api", "get-public-access-block"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-lifecycle-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-acl"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-ownership-controls"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-logging"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-cors"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-website"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-replication"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-notification-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-object-lock-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-request-payment"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-accelerate-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-analytics-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-inventory-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-metrics-configuration"]}},
                {"argv": {"prefix": ["s3api", "get-bucket-intelligent-tiering-configuration"]}},
                {"argv": {"prefix": ["s3api", "list-bucket-analytics-configurations"]}},
                {"argv": {"prefix": ["s3api", "list-bucket-inventory-configurations"]}},
                {"argv": {"prefix": ["s3api", "list-bucket-metrics-configurations"]}},
                {"argv": {"prefix": ["s3api", "list-bucket-intelligent-tiering-configurations"]}},
                {"argv": {"prefix": ["rds", "describe-db-instances"]}},
                {"argv": {"prefix": ["rds", "describe-db-clusters"]}},
                {"argv": {"prefix": ["rds", "describe-reserved-db-instances"]}},
                {"argv": {"prefix": ["eks", "list-clusters"]}},
                {"argv": {"prefix": ["eks", "describe-cluster"]}},
                {"argv": {"prefix": ["eks", "list-nodegroups"]}},
                {"argv": {"prefix": ["eks", "describe-nodegroup"]}},
                {"argv": {"prefix": ["ecs", "list-clusters"]}},
                {"argv": {"prefix": ["ecs", "describe-clusters"]}},
                {"argv": {"prefix": ["ecs", "list-services"]}},
                {"argv": {"prefix": ["ecs", "describe-services"]}},
                {"argv": {"prefix": ["ecs", "list-tasks"]}},
                {"argv": {"prefix": ["ecs", "describe-tasks"]}},
                {"argv": {"prefix": ["ecs", "describe-task-definition"]}},
                {"argv": {"prefix": ["lambda", "list-functions"]}},
                {"argv": {"prefix": ["lambda", "get-function-configuration"]}},
                {"argv": {"prefix": ["dynamodb", "list-tables"]}},
                {"argv": {"prefix": ["dynamodb", "describe-table"]}},
                {"argv": {"prefix": ["elbv2", "describe-load-balancers"]}},
                {"argv": {"prefix": ["elbv2", "describe-target-groups"]}},
                {"argv": {"prefix": ["autoscaling", "describe-auto-scaling-groups"]}},
                {"argv": {"prefix": ["ecr", "describe-repositories"]}},
                {"argv": {"prefix": ["ecr", "describe-images"]}},
                {"argv": {"prefix": ["iam", "get-user"]}},
                {"argv": {"prefix": ["iam", "list-roles"]}},
                {"argv": {"prefix": ["iam", "get-role"]}},
                {"argv": {"prefix": ["iam", "list-policies"]}},
                {"argv": {"prefix": ["iam", "get-policy"]}},
                {"argv": {"prefix": ["iam", "list-attached-role-policies"]}},
                {"argv": {"prefix": ["cloudformation", "list-stacks"]}},
                {"argv": {"prefix": ["cloudformation", "describe-stacks"]}},
                {"argv": {"prefix": ["cloudformation", "describe-stack-resources"]}},
                {"argv": {"prefix": ["cloudwatch", "list-metrics"]}},
                {"argv": {"prefix": ["cloudwatch", "get-metric-statistics"]}},
                {"argv": {"prefix": ["cloudwatch", "get-metric-data"]}},
                {"argv": {"prefix": ["logs", "describe-log-groups"]}},
                {"argv": {"prefix": ["logs", "filter-log-events"]}},
                {"argv": {"prefix": ["logs", "tail"]}},
                {"argv": {"prefix": ["ce", "get-cost-and-usage"]}},
                {"argv": {"prefix": ["ce", "get-cost-forecast"]}},
                {"argv": {"prefix": ["ce", "get-dimension-values"]}},
                {"argv": {"prefix": ["ce", "get-tags"]}},
                {"argv": {"prefix": ["pricing", "get-products"]}},
                {"argv": {"prefix": ["pricing", "describe-services"]}},
                {"argv": {"prefix": ["pricing", "get-attribute-values"]}},
                {"argv": {"prefix": ["organizations", "list-accounts"]}},
                {"argv": {"prefix": ["organizations", "describe-organization"]}},
                {"argv": {"prefix": ["resourcegroupstaggingapi", "get-resources"]}},
                {"argv": {"prefix": ["route53", "list-hosted-zones"]}},
                {"argv": {"prefix": ["route53", "list-resource-record-sets"]}},
                {"argv": {"prefix": ["sqs", "list-queues"]}},
                {"argv": {"prefix": ["sqs", "get-queue-attributes"]}},
                {"argv": {"prefix": ["sns", "list-topics"]}},
                {"argv": {"prefix": ["ssm", "describe-parameters"]}},
                {"argv": {"prefix": ["kms", "list-keys"]}},
                {"argv": {"prefix": ["kms", "describe-key"]}}
              ]
            }
          }
        }
      },
      "az": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["$HOME/.azure", "/nix/store"],
              "fs_write": ["$HOME/.azure/logs", "$HOME/.azure/telemetry", "$HOME/.azure/commandIndex.json", "$HOME/.azure/msal_token_cache.json", "$HOME/.azure/msal_http_cache.bin", "$HOME/.azure/versionCheck.json"],
              "unsafe_macos_seatbelt_rules": ["(allow process-exec* (subpath \"/nix/store\"))"],
              "network": {
                "allow_all": true
              },
              "environment": {
                "allow_vars": ["HOME", "PATH", "TERM", "AZURE_CONFIG_DIR", "AZURE_EXTENSION_DIR", "AZURE_CORE_OUTPUT", "AZURE_CORE_NO_COLOR", "AZURE_CORE_ONLY_SHOW_ERRORS"]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                {"argv": {"contains": ["--subscription"]}, "reason": "agents use the shell's logged-in Azure subscription and tenant"},
                {"argv": {"contains": ["--tenant"]}, "reason": "agents use the shell's logged-in Azure subscription and tenant"},
                {"argv": {"contains": ["--password"]}, "reason": "agents use the shell's logged-in Azure subscription and tenant"},
                {"argv": {"contains": ["--service-principal"]}, "reason": "agents use the shell's logged-in Azure subscription and tenant"},
                {"argv": {"contains": ["--federated-token"]}, "reason": "agents use the shell's logged-in Azure subscription and tenant"}
              ],
              "allow": [
                {"argv": {"prefix": ["version"]}},
                {"argv": {"prefix": ["account", "show"]}},
                {"argv": {"prefix": ["account", "list"]}},
                {"argv": {"prefix": ["account", "list-locations"]}},
                {"argv": {"prefix": ["account", "tenant", "list"]}},
                {"argv": {"prefix": ["account", "management-group", "list"]}},
                {"argv": {"prefix": ["cloud", "list"]}},
                {"argv": {"prefix": ["cloud", "show"]}},
                {"argv": {"prefix": ["configure", "--list-defaults"]}},
                {"argv": {"prefix": ["extension", "list"]}},
                {"argv": {"prefix": ["ad", "signed-in-user", "show"]}},
                {"argv": {"prefix": ["group", "list"]}},
                {"argv": {"prefix": ["group", "show"]}},
                {"argv": {"prefix": ["resource", "list"]}},
                {"argv": {"prefix": ["resource", "show"]}},
                {"argv": {"prefix": ["provider", "list"]}},
                {"argv": {"prefix": ["provider", "show"]}},
                {"argv": {"prefix": ["tag", "list"]}},
                {"argv": {"prefix": ["lock", "list"]}},
                {"argv": {"prefix": ["deployment", "group", "list"]}},
                {"argv": {"prefix": ["deployment", "group", "show"]}},
                {"argv": {"prefix": ["deployment", "sub", "list"]}},
                {"argv": {"prefix": ["deployment", "sub", "show"]}},
                {"argv": {"prefix": ["vm", "list"]}},
                {"argv": {"prefix": ["vm", "show"]}},
                {"argv": {"prefix": ["vm", "list-sizes"]}},
                {"argv": {"prefix": ["vm", "list-skus"]}},
                {"argv": {"prefix": ["vm", "list-vm-resize-options"]}},
                {"argv": {"prefix": ["vmss", "list"]}},
                {"argv": {"prefix": ["vmss", "show"]}},
                {"argv": {"prefix": ["disk", "list"]}},
                {"argv": {"prefix": ["disk", "show"]}},
                {"argv": {"prefix": ["snapshot", "list"]}},
                {"argv": {"prefix": ["image", "list"]}},
                {"argv": {"prefix": ["identity", "list"]}},
                {"argv": {"prefix": ["identity", "show"]}},
                {"argv": {"prefix": ["network", "vnet", "list"]}},
                {"argv": {"prefix": ["network", "vnet", "show"]}},
                {"argv": {"prefix": ["network", "vnet", "subnet", "list"]}},
                {"argv": {"prefix": ["network", "vnet", "subnet", "show"]}},
                {"argv": {"prefix": ["network", "nsg", "list"]}},
                {"argv": {"prefix": ["network", "nsg", "show"]}},
                {"argv": {"prefix": ["network", "nic", "list"]}},
                {"argv": {"prefix": ["network", "nic", "show"]}},
                {"argv": {"prefix": ["network", "public-ip", "list"]}},
                {"argv": {"prefix": ["network", "public-ip", "show"]}},
                {"argv": {"prefix": ["network", "lb", "list"]}},
                {"argv": {"prefix": ["network", "lb", "show"]}},
                {"argv": {"prefix": ["network", "nat", "gateway", "list"]}},
                {"argv": {"prefix": ["network", "private-endpoint", "list"]}},
                {"argv": {"prefix": ["network", "dns", "zone", "list"]}},
                {"argv": {"prefix": ["network", "dns", "record-set", "list"]}},
                {"argv": {"prefix": ["storage", "account", "list"]}},
                {"argv": {"prefix": ["storage", "account", "show"]}},
                {"argv": {"prefix": ["storage", "account", "show-usage"]}},
                {"argv": {"prefix": ["storage", "container", "list"]}},
                {"argv": {"prefix": ["storage", "blob", "list"]}},
                {"argv": {"prefix": ["aks", "list"]}},
                {"argv": {"prefix": ["aks", "show"]}},
                {"argv": {"prefix": ["aks", "nodepool", "list"]}},
                {"argv": {"prefix": ["aks", "nodepool", "show"]}},
                {"argv": {"prefix": ["acr", "list"]}},
                {"argv": {"prefix": ["acr", "show"]}},
                {"argv": {"prefix": ["acr", "repository", "list"]}},
                {"argv": {"prefix": ["acr", "repository", "show-tags"]}},
                {"argv": {"prefix": ["containerapp", "list"]}},
                {"argv": {"prefix": ["containerapp", "show"]}},
                {"argv": {"prefix": ["containerapp", "env", "list"]}},
                {"argv": {"prefix": ["webapp", "list"]}},
                {"argv": {"prefix": ["webapp", "show"]}},
                {"argv": {"prefix": ["functionapp", "list"]}},
                {"argv": {"prefix": ["functionapp", "show"]}},
                {"argv": {"prefix": ["appservice", "plan", "list"]}},
                {"argv": {"prefix": ["appservice", "plan", "show"]}},
                {"argv": {"prefix": ["sql", "server", "list"]}},
                {"argv": {"prefix": ["sql", "server", "show"]}},
                {"argv": {"prefix": ["sql", "db", "list"]}},
                {"argv": {"prefix": ["sql", "db", "show"]}},
                {"argv": {"prefix": ["postgres", "flexible-server", "list"]}},
                {"argv": {"prefix": ["postgres", "flexible-server", "show"]}},
                {"argv": {"prefix": ["mysql", "flexible-server", "list"]}},
                {"argv": {"prefix": ["mysql", "flexible-server", "show"]}},
                {"argv": {"prefix": ["cosmosdb", "list"]}},
                {"argv": {"prefix": ["cosmosdb", "show"]}},
                {"argv": {"prefix": ["redis", "list"]}},
                {"argv": {"prefix": ["redis", "show"]}},
                {"argv": {"prefix": ["servicebus", "namespace", "list"]}},
                {"argv": {"prefix": ["eventhubs", "namespace", "list"]}},
                {"argv": {"prefix": ["keyvault", "list"]}},
                {"argv": {"prefix": ["keyvault", "show"]}},
                {"argv": {"prefix": ["monitor", "metrics", "list"]}},
                {"argv": {"prefix": ["monitor", "metrics", "list-definitions"]}},
                {"argv": {"prefix": ["monitor", "activity-log", "list"]}},
                {"argv": {"prefix": ["monitor", "log-analytics", "workspace", "list"]}},
                {"argv": {"prefix": ["monitor", "log-analytics", "workspace", "show"]}},
                {"argv": {"prefix": ["monitor", "diagnostic-settings", "list"]}},
                {"argv": {"prefix": ["role", "assignment", "list"]}},
                {"argv": {"prefix": ["role", "definition", "list"]}},
                {"argv": {"prefix": ["policy", "assignment", "list"]}},
                {"argv": {"prefix": ["policy", "definition", "list"]}},
                {"argv": {"prefix": ["advisor", "recommendation", "list"]}},
                {"argv": {"prefix": ["consumption", "usage", "list"]}},
                {"argv": {"prefix": ["consumption", "budget", "list"]}},
                {"argv": {"prefix": ["billing", "account", "list"]}}
              ]
            }
          }
        }
      }
    }
  }
}
